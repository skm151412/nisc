rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // NISC ELECTION SYSTEM - SECURITY RULES (PURE SPARK PLAN)
    // Architecture: Zero-Trust Client Model & Principle of Least Privilege
    // All authorization, state transitions, and voting invariants enforced by Firestore Rules
    // =========================================================================

    // Basic Authentication & Verification Predicates
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Super Administrator Predicate
    // Authorized only for the designated administrative identities:
    // - skm151412@gmail.com
    // - mohiuddinahmad9abcs@gmail.com
    // with email_verified == true, or verified server-assigned custom claim admin == true,
    // or verified existence in /admins/{uid}.
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email in ['skm151412@gmail.com', 'mohiuddinahmad9abcs@gmail.com'] && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Checks if the authenticated user owns the document record matching their UID
    function isMemberOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Default Deny-All Catch-All Rule
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. MEMBERS COLLECTION (/members/{uid})
    // Indexed strictly by Firebase Authentication UID.
    // =========================================================================
    match /members/{uid} {
      // Super admin can read all member records;
      // An authenticated voter can only GET their own member document.
      allow get: if isSuperAdmin() || isMemberOwner(uid);

      // Ordinary voters are STRICTLY FORBIDDEN from listing or querying the collection.
      // This protects the voter list against scraping or enumeration attacks.
      allow list: if isSuperAdmin();

      // Creation allowed for self during first sign-in/seeding or super admin
      allow create: if isSuperAdmin() || (isMemberOwner(uid) && request.resource.data.hasVoted == false);

      // Voter can only update their own record to mark hasVoted: true upon voting
      allow update: if isSuperAdmin() || (
        isMemberOwner(uid) &&
        resource.data.hasVoted == false &&
        request.resource.data.hasVoted == true &&
        request.resource.data.eligible == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasVoted', 'receiptId', 'votedAt', 'updatedAt', 'lastLoginAt'])
      );

      // Deletion is strictly super-admin only
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. ADMINS COLLECTION (/admins/{uid})
    // Indexed strictly by Firebase Authentication UID.
    // =========================================================================
    match /admins/{uid} {
      allow read, write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. ELECTIONS COLLECTION (/elections/{electionId})
    // Top-level election configuration and status lifecycle.
    // =========================================================================
    match /elections/{electionId} {
      // Authenticated users can read safe election information (status, title, description).
      allow get, list: if isSignedIn();

      // Only Super Admin can mutate election settings or change lifecycle state.
      allow write: if isSuperAdmin();

      // =======================================================================
      // 4. CANDIDATES SUBCOLLECTION (/elections/{electionId}/candidates/{candidateId})
      // Official candidates standing for election positions.
      // =======================================================================
      match /candidates/{candidateId} {
        // Authenticated voters can read candidate details (vision, pillars, codename).
        allow get, list: if isSignedIn();

        // Admin can manage candidates
        allow create, delete: if isSuperAdmin();

        // Increment voteCount by 1 during active voting or admin update
        allow update: if isSuperAdmin() || (
          isSignedIn() &&
          (get(/databases/$(database)/documents/elections/$(electionId)).data.status == 'LIVE' ||
           get(/databases/$(database)/documents/elections/$(electionId)).data.status == 'OPEN') &&
          request.resource.data.voteCount == resource.data.voteCount + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount', 'updatedAt'])
        );
      }

      // =======================================================================
      // 4b. RESULTS SUBCOLLECTION (/elections/{electionId}/results/{resultDoc})
      // Official aggregate election results summary.
      // Strictly protected against pre-publication leakage:
      // Visible to authenticated voters ONLY AFTER results are officially published.
      // =======================================================================
      match /results/{resultDoc} {
        // Super admin can always read;
        // Authenticated voters can read ONLY when election status is FINISHED or RESULTS
        allow get, list: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/elections/$(electionId)).data.status == 'FINISHED' ||
          get(/databases/$(database)/documents/elections/$(electionId)).data.status == 'RESULTS'
        );

        // Results snapshot is generated and published by the administrator upon finishing the election
        allow write: if isSuperAdmin();
      }
    }

    // =========================================================================
    // 5. BALLOTS COLLECTION (/ballots/{ballotId})
    // Immutable sealed votes recording voter-to-candidate mapping.
    // =========================================================================
    match /ballots/{ballotId} {
      // Ordinary voters are strictly DENIED from querying or reading ballots.
      // Only Super Admin can read ballots for auditability and verification.
      allow read: if isSuperAdmin();

      // Ballot creation: Voter can create their ballot during an active election
      allow create: if isSignedIn() &&
        request.resource.data.voterUid == request.auth.uid &&
        request.resource.data.candidateId in ['zeus', 'athena', 'poseidon'] &&
        (get(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data.status == 'LIVE' ||
         get(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data.status == 'OPEN') &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.eligible == true &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.hasVoted == false;

      // Ballots are strictly immutable
      allow update, delete: if false;
    }

    // =========================================================================
    // 6. AUDIT LOGS COLLECTION (/auditLogs/{auditId})
    // Append-only tamper-resistant security event ledger.
    // =========================================================================
    match /auditLogs/{auditId} {
      // Only Super Admin can read audit logs.
      allow read: if isSuperAdmin();

      // Append-only creation by authenticated actors or admin
      allow create: if isSignedIn() && (
        request.resource.data.actorUid == request.auth.uid ||
        isSuperAdmin()
      );

      // Audit logs cannot be modified or deleted
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. VOTE LOCKS COLLECTION (/voteLocks/{lockId})
    // Transaction idempotency & concurrency lock: UNIQUE(electionId, voterUid)
    // =========================================================================
    match /voteLocks/{lockId} {
      // Super Admin can read locks; voter can read their own lock
      allow read: if isSuperAdmin() || (isSignedIn() && lockId == resource.data.electionId + '_' + request.auth.uid);

      // Lock creation: voter claims lock with document ID = electionId_voterUid
      allow create: if isSignedIn() &&
        request.resource.data.voterUid == request.auth.uid &&
        lockId == request.resource.data.electionId + '_' + request.auth.uid &&
        !exists(/databases/$(database)/documents/voteLocks/$(lockId));

      // Locks cannot be mutated or deleted
      allow update, delete: if false;
    }
  }
}

