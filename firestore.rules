rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // NISC ELECTION SYSTEM - SECURITY RULES (ZERO-TRUST REMEDIATED)
    // Architecture: Zero-Trust Client Model & Principle of Least Privilege
    // Enforces: SEC-01 (Authoritative approvedVoters registry),
    //           SEC-02 (Zero client candidate write/inflation permissions),
    //           SEC-03 (Private live tallies, protected results),
    //           SEC-04 (Admin audit access only on ballots),
    //           State transition enforcement (Voting permitted strictly when LIVE).
    // =========================================================================

    // Basic Authentication & Verification Predicates
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function normEmail(email) {
      return email.trim().lower();
    }

    function callerEmail() {
      return normEmail(request.auth.token.email);
    }

    // Super Administrator Predicate
    // Authorized strictly for designated administrative identities with verified email,
    // custom admin claims, or verified entry in /admins/{uid}.
    function isSuperAdmin() {
      return isSignedIn() && (
        (callerEmail() in ['skm151412@gmail.com', 'mohiuddinahmad9abcs@gmail.com'] && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Checks if the authenticated user owns the document record matching their UID
    function isMemberOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Default Deny-All Catch-All Rule
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 0. APPROVED VOTERS REGISTRY (/approvedVoters/{email})
    // Authoritative backend voter registry indexed by normalized student email.
    // Ordinary voters CANNOT create, modify, or delete registry records.
    // =========================================================================
    match /approvedVoters/{email} {
      // Super admin can read all registry entries;
      // An authenticated voter can only read their own registry entry.
      allow get: if isSuperAdmin() || (isSignedIn() && normEmail(email) == callerEmail());
      allow list: if isSuperAdmin();

      // Only Super Admin can write (create, update, delete) approved voter records
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 1. MEMBERS COLLECTION (/members/{uid})
    // Indexed strictly by Firebase Authentication UID.
    // =========================================================================
    match /members/{uid} {
      // Super admin can read all member records;
      // An authenticated voter can only GET their own member document.
      allow get: if isSuperAdmin() || isMemberOwner(uid);

      // Ordinary voters are STRICTLY FORBIDDEN from listing or querying the collection.
      allow list: if isSuperAdmin();

      // Creation:
      // Super Admin can create member records.
      // An authenticated user can ONLY create their own member record IF:
      // 1. request.auth.uid == uid
      // 2. Email is verified
      // 3. Their normalized email EXACTLY exists in /approvedVoters/{normalizedEmail}
      // 4. The approvedVoters record has eligible == true
      // 5. The created record's email matches callerEmail()
      // 6. hasVoted is false
      // 7. eligible is true
      // 8. No admin or role escalation
      allow create: if isSuperAdmin() || (
        isMemberOwner(uid) &&
        isEmailVerified() &&
        exists(/databases/$(database)/documents/approvedVoters/$(callerEmail())) &&
        get(/databases/$(database)/documents/approvedVoters/$(callerEmail())).data.eligible == true &&
        normEmail(request.resource.data.email) == callerEmail() &&
        request.resource.data.hasVoted == false &&
        request.resource.data.eligible == true &&
        (!('role' in request.resource.data) || request.resource.data.role == 'VOTER') &&
        (!('admin' in request.resource.data) || request.resource.data.admin == false)
      );

      // Voter can only update their own record to mark hasVoted: true upon voting.
      // CANNOT change hasVoted from true back to false.
      // CANNOT change eligible, email, rollNumber, batch, department, role, admin.
      allow update: if isSuperAdmin() || (
        isMemberOwner(uid) &&
        resource.data.hasVoted == false &&
        request.resource.data.hasVoted == true &&
        resource.data.eligible == true &&
        request.resource.data.eligible == true &&
        resource.data.email == request.resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasVoted', 'receiptId', 'votedAt', 'updatedAt', 'lastLoginAt'])
      );

      // Deletion is strictly super-admin only
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. ADMINS COLLECTION (/admins/{uid})
    // Indexed strictly by Firebase Authentication UID.
    // =========================================================================
    match /admins/{uid} {
      allow read, write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. ELECTIONS COLLECTION (/elections/{electionId})
    // Top-level election configuration and status lifecycle.
    // =========================================================================
    match /elections/{electionId} {
      // Authenticated users can read safe election information (status, title, description).
      allow get, list: if isSignedIn();

      // Only Super Admin can mutate election settings or change lifecycle state.
      allow write: if isSuperAdmin();

      // =======================================================================
      // 4. CANDIDATES SUBCOLLECTION (/elections/{electionId}/candidates/{candidateId})
      // Official candidates standing for election positions.
      // =======================================================================
      match /candidates/{candidateId} {
        // Authenticated voters can read candidate details (vision, pillars, codename).
        allow get, list: if isSignedIn();

        // STRICT SEC-02 REMEDIATION:
        // Ordinary clients have ZERO write permissions on candidate documents.
        // No client-side voteCount increments are permitted under any circumstance.
        allow write: if isSuperAdmin();
      }

      // =======================================================================
      // 4b. TALLIES SUBCOLLECTION (/elections/{electionId}/tallies/{candidateId})
      // SEC-03: Real-time vote tallies are strictly private.
      // Ordinary voters CANNOT read or write live tallies at any time.
      // =======================================================================
      match /tallies/{candidateId} {
        allow read, write: if isSuperAdmin();
      }

      // =======================================================================
      // 4c. RESULTS SUBCOLLECTION (/elections/{electionId}/results/{resultDoc})
      // Official aggregate election results summary.
      // Strictly protected against pre-publication leakage:
      // Visible to authenticated voters ONLY AFTER election is FINISHED or RESULTS.
      // =======================================================================
      match /results/{resultDoc} {
        // Super admin can always read;
        // Authenticated voters can read ONLY when election status is FINISHED or RESULTS
        allow get, list: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/elections/$(electionId)).data.status == 'FINISHED' ||
          get(/databases/$(database)/documents/elections/$(electionId)).data.status == 'RESULTS'
        );

        // Results snapshot is generated and published by the administrator upon finishing the election
        allow write: if isSuperAdmin();
      }
    }

    // =========================================================================
    // 5. BALLOTS COLLECTION (/ballots/{ballotId})
    // Immutable sealed votes recording voter-to-candidate mapping.
    // =========================================================================
    match /ballots/{ballotId} {
      // Ordinary voters are strictly DENIED from querying or reading ballots.
      // Only Super Admin can read ballots for auditability and verification.
      allow read: if isSuperAdmin();

      // Ballot creation: Voter can create their ballot ONLY IF:
      // 1. Authenticated with verified email
      // 2. voterUid == request.auth.uid
      // 3. voterEmail matches authenticated email
      // 4. Exists in /approvedVoters/{email} with eligible == true
      // 5. Exists in /members/{uid} with eligible == true and hasVoted == false
      // 6. Valid candidate ID in ['zeus', 'athena', 'poseidon']
      // 7. Election status is strictly 'LIVE'
      allow create: if isSignedIn() &&
        isEmailVerified() &&
        request.resource.data.voterUid == request.auth.uid &&
        normEmail(request.resource.data.voterEmail) == callerEmail() &&
        exists(/databases/$(database)/documents/approvedVoters/$(callerEmail())) &&
        get(/databases/$(database)/documents/approvedVoters/$(callerEmail())).data.eligible == true &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.eligible == true &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.hasVoted == false &&
        request.resource.data.candidateId in ['zeus', 'athena', 'poseidon'] &&
        get(/databases/$(database)/documents/elections/$(request.resource.data.electionId)).data.status == 'LIVE';

      // Ballots are strictly immutable for normal users; deletion only permitted for Super Admin vote resets
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 6. AUDIT LOGS COLLECTION (/auditLogs/{auditId})
    // Append-only tamper-resistant security event ledger.
    // =========================================================================
    match /auditLogs/{auditId} {
      // Only Super Admin can read audit logs.
      allow read: if isSuperAdmin();

      // Append-only creation by authenticated actors or admin
      allow create: if isSignedIn() && (
        request.resource.data.actorUid == request.auth.uid ||
        isSuperAdmin()
      );

      // Audit logs cannot be modified or deleted
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. VOTE LOCKS COLLECTION (/voteLocks/{lockId})
    // Transaction idempotency & concurrency lock: UNIQUE(electionId, voterUid)
    // =========================================================================
    match /voteLocks/{lockId} {
      // Super Admin can read locks; voter can read their own lock
      allow read: if isSuperAdmin() || (isSignedIn() && lockId == resource.data.electionId + '_' + request.auth.uid);

      // Lock creation: voter claims lock with document ID = electionId_voterUid
      allow create: if isSignedIn() &&
        request.resource.data.voterUid == request.auth.uid &&
        lockId == request.resource.data.electionId + '_' + request.auth.uid &&
        !exists(/databases/$(database)/documents/voteLocks/$(lockId));

      // Locks cannot be mutated; deletion only permitted for Super Admin vote resets
      allow update: if false;
      allow delete: if isSuperAdmin();
    }
  }
}

